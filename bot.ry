import os
import time
import random
import sqlite3
import logging
from datetime import datetime, timedelta
from selenium import webdriver
from selenium.webdriver.common.by import By
from selenium.webdriver.support.ui import WebDriverWait
from selenium.webdriver.support import expected_conditions as EC
from selenium.webdriver.chrome.options import Options
from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import Application, CommandHandler, CallbackQueryHandler, ContextTypes

# ---------- КОНФИГ ----------
TELEGRAM_TOKEN = os.getenv8769381388:AAHE7NFRWFJM3RDYN jQvggaw8Q
yaRkqP7u0
ADMIN_CHAT_ID = os.getenv 8888320555
WHATSAPP_NUMBER = "+351927884875"  # твой номер WhatsApp

STEPS = [
    "Olá, este produto ainda está à venda?",
    "O produto está em bom estado, sem danos? Corresponde totalmente à descrição?",
    "Estou bastante interessado na compra; gostaria de comprar. Por favor, me digam: é possível fazer a entrega pelo serviço de courier CTT?",
    f"Envie-me uma mensagem para o número indicado, para que possamos discutir a compra com mais pormenor {WHATSAPP_NUMBER}"
]

ADS_LIST = [
    "https://www.custojusto.pt/anuncio/12345",  # замени на свои ссылки
]

MIN_INTERVAL_MINUTES = 30
SLEEP_BETWEEN_ADS = 10

# ---------- БАЗА ДАННЫХ ----------
def init_db():
    conn = sqlite3.connect("bot_state.db")
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS dialogs (
        ad_url TEXT PRIMARY KEY,
        thread_id TEXT,
        step INTEGER DEFAULT 0,
        last_sent TIMESTAMP,
        last_message TEXT
    )''')
    conn.commit()
    conn.close()

def get_dialog_state(ad_url):
    conn = sqlite3.connect("bot_state.db")
    c = conn.cursor()
    c.execute("SELECT step, last_sent FROM dialogs WHERE ad_url = ?", (ad_url,))
    row = c.fetchone()
    conn.close()
    if row:
        return {"step": row[0], "last_sent": row[1]}
    return None

def update_dialog_state(ad_url, step, last_sent=None, thread_id=None, last_message=None):
    conn = sqlite3.connect("bot_state.db")
    c = conn.cursor()
    now = datetime.now().isoformat() if last_sent is None else last_sent
    if thread_id and last_message:
        c.execute("REPLACE INTO dialogs (ad_url, thread_id, step, last_sent, last_message) VALUES (?, ?, ?, ?, ?)",
                  (ad_url, thread_id, step, now, last_message))
    else:
        c.execute("REPLACE INTO dialogs (ad_url, step, last_sent) VALUES (?, ?, ?)",
                  (ad_url, step, now))
    conn.commit()
    conn.close()

def can_send(ad_url):
    state = get_dialog_state(ad_url)
    if not state or state["last_sent"] is None:
        return True
    last_time = datetime.fromisoformat(state["last_sent"])
    now = datetime.now()
    return (now - last_time) >= timedelta(minutes=MIN_INTERVAL_MINUTES)

def random_delay(min_sec=3, max_sec=7):
    time.sleep(random.uniform(min_sec, max_sec))

def is_positive_response(text):
    positive_words = ["sim", "ok", "yes", "claro", "está", "pode", "tudo bem", "bom estado", "sem danos", "tranquilo", "perfeito", "excelente"]
    text_lower = text.lower()
    return any(word in text_lower for word in positive_words)

def get_thread_url(driver, ad_url):
    driver.get(ad_url)
    random_delay(2, 4)
    try:
        chat_btn = WebDriverWait(driver, 10).until(
            EC.element_to_be_clickable((By.XPATH, "//button[contains(text(), 'Enviar mensagem')]"))
        )
        chat_btn.click()
        random_delay(2, 4)
        return driver.current_url
    except Exception as e:
        logging.error(f"Не удалось открыть чат для {ad_url}: {e}")
        return None

def get_latest_reply(driver, thread_url):
    driver.get(thread_url)
    random_delay(2, 4)
    try:
        messages = driver.find_elements(By.XPATH, "//div[contains(@class, 'message')]")
        if not messages:
            return ""
        return messages[-1].text.strip()
    except Exception as e:
        logging.error(f"Ошибка получения последнего сообщения: {e}")
        return ""

def send_message_in_thread(driver, thread_url, text):
    driver.get(thread_url)
    random_delay(2, 4)
    try:
        textarea = WebDriverWait(driver, 10).until(
            EC.presence_of_element_located((By.XPATH, "//textarea"))
        )
        textarea.clear()
        textarea.send_keys(text)
        random_delay(1, 3)
        send_btn = driver.find_element(By.XPATH, "//button[contains(text(), 'Enviar')]")
        send_btn.click()
        random_delay(2, 4)
        return True
    except Exception as e:
        logging.error(f"Ошибка отправки в {thread_url}: {e}")
        return False

def process_ad(driver, ad_url):
    state = get_dialog_state(ad_url)
    current_step = state["step"] if state else 0
    if current_step >= len(STEPS):
        logging.info(f"Диалог {ad_url} уже завершён")
        return
    if not can_send(ad_url):
        logging.info(f"Пропускаем {ad_url} — интервал 30 мин не прошёл")
        return
    thread_url = get_thread_url(driver, ad_url)
    if not thread_url:
        return
    if current_step == 0:
        success = send_message_in_thread(driver, thread_url, STEPS[0])
        if success:
            update_dialog_state(ad_url, 1, thread_id=thread_url, last_message=STEPS[0])
            logging.info(f"Шаг 1 отправлен на {ad_url}")
        return
    last_reply = get_latest_reply(driver, thread_url)
    if not last_reply:
        return
    if is_positive_response(last_reply):
        next_step = current_step + 1
        if next_step < len(STEPS):
            success = send_message_in_thread(driver, thread_url, STEPS[next_step])
            if success:
                update_dialog_state(ad_url, next_step, thread_id=thread_url, last_message=STEPS[next_step])
                logging.info(f"Шаг {next_step+1} отправлен на {ad_url}")
        else:
            update_dialog_state(ad_url, len(STEPS), thread_id=thread_url)
            logging.info(f"Диалог {ad_url} завершён")

def run_distribution():
    options = Options()
    options.add_argument("--headless")
    options.add_argument("--no-sandbox")
    options.add_argument("--disable-dev-shm-usage")
    options.add_argument("--window-size=1920,1080")
    driver = webdriver.Chrome(options=options)
    try:
        for url in ADS_LIST:
            process_ad(driver, url)
            time.sleep(SLEEP_BETWEEN_ADS)
    finally:
        driver.quit()

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    if str(update.effective_user.id) != ADMIN_CHAT_ID:
        await update.message.reply_text("Доступ запрещён.")
        return
    keyboard = [
        [InlineKeyboardButton("🚀 Запустить рассылку", callback_data="run")],
        [InlineKeyboardButton("📊 Статус", callback_data="status")],
    ]
    await update.message.reply_text("Управление ботом CustoJusto:", reply_markup=InlineKeyboardMarkup(keyboard))

async def button(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    if str(update.effective_user.id) != ADMIN_CHAT_ID:
        await query.edit_message_text("Доступ запрещён.")
        return
    if query.data == "run":
        run_distribution()
        await query.edit_message_text("✅ Рассылка выполнена.")
    elif query.data == "status":
        await query.edit_message_text("📊 Бот работает. Интервал 30 мин.")

def main():
    init_db()
    logging.basicConfig(level=logging.INFO)
    app = Application.builder().token(TELEGRAM_TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    app.add_handler(CallbackQueryHandler(button))
    app.run_polling()

if __name__ == "__main__":
    main()
